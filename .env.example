PORT=5500

# En kolay + güvenilir yöntem: Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=BREVO_LOGIN_EMAIL
SMTP_PASS=

# (Opsiyonel - yalnız Outlook OAuth2 kullanacaksan doldur)
MS_TENANT_ID=consumers
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_GRAPH_SCOPE=https://graph.microsoft.com/Mail.Send offline_access

# Form mesajları nereye gitsin?
MAIL_TO=acarlarelektrik@outlook.com.tr
# (Opsiyonel) Outlook'ta görünmezse aynı bildirimi yedek adrese de gönder
MAIL_TO_BACKUP=

# Gönderen bilgisi
MAIL_FROM_NAME=Acarlar Elektrik Site
# Brevo'da doğruladığınız sender e-posta adresini yazın
MAIL_FROM_EMAIL=acarlarelektrik@outlook.com.tr

